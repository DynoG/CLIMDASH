# ─── Provider selection ────────────────────────────────────────────────
# Which provider to use for ingestion. Options: open_meteo, generic_rest
PROVIDER=open_meteo

# ─── Open-Meteo (free tier needs no key; commercial tier uses a key) ──
OPEN_METEO_COMMERCIAL=false
OPEN_METEO_API_KEY=

# ─── Generic REST provider (placeholder for any future API) ───────────
# Fill these in when you integrate a token-authenticated API.
# The generic_rest provider reads exactly these three variables.
GENERIC_API_BASE_URL=
GENERIC_API_TOKEN=
GENERIC_API_AUTH_HEADER=X-API-KEY

# ─── Paths ─────────────────────────────────────────────────────────────
CITIES_CSV=data/cities.csv
RAW_CACHE_DIR=data/raw
PROCESSED_DIR=data/processed

# ─── Defaults ──────────────────────────────────────────────────────────
DEFAULT_METRIC=temperature_2m
DEFAULT_HISTORY_DAYS=7